DISCORD_TOKEN=

# https address other people reach the sign-in site at (required for /login to work for them)
MAIMAI_PUBLIC_URL=https://rasmai.lol

# "quick" runs a throwaway cloudflared tunnel and adopts its URL; needs cloudflared on PATH. Leave empty if you front the port yourself.
MAIMAI_TUNNEL=

# generated into data/secret.key when empty
MAIMAI_TOTP_SECRET=
# the website (Next.js) and the bot talk over a local port; both read this and it must match.
# any long random string. Empty only works when the bot listens on loopback.
RASMAI_INTERNAL_SECRET=
# signs the dashboard's session cookies; empty falls back to MAIMAI_TOTP_SECRET, then to a per-start key
RASMAI_SESSION_SECRET=
# a key for /api/statuspage, /api/statuspage/metrics and /api/statuspage/history, which report the bot's health to a status page. Any long random string; empty leaves those endpoints switched off.
STATUSPAGE_TOKEN=

# Discord user id of the one account that can open the developer page and run /notice. Empty disables both.
MAIMAI_ADMIN_ID=
# Discord server id where /notice is registered, so it appears only there. Empty registers it globally (still admin-only).
MAIMAI_CONTROL_GUILD_ID=
# Set to true only when Cloudflare (tunnel or proxy) is the sole way to reach the site. Then CF-Connecting-IP is trusted as the client address for rate limits; otherwise it is ignored and the last X-Forwarded-For hop is used.
MAIMAI_BEHIND_CLOUDFLARE=false
# where the website finds the bot's internal API (docker compose sets http://bot:8765)
MAIMAI_INTERNAL_URL=http://127.0.0.1:8765
# where a bot-run cloudflared tunnel points: the website (docker compose sets http://web:3000)
MAIMAI_TUNNEL_ORIGIN=http://127.0.0.1:3000
MAIMAI_DATABASE_PATH=data/maimai.sqlite3
MAIMAI_WEBSERVER_HOST=127.0.0.1
MAIMAI_WEBSERVER_PORT=8765
MAIMAI_PLAY_COUNT_FETCH_LIMIT=60

# capacity: how many score reads and image renders run at once, the request rate to maimai DX NET
# shared by everyone, the loading-bar edit rate shared by everyone, and finished analyses kept in memory
MAIMAI_MAX_CONCURRENT=24
MAIMAI_MAX_RENDERS=4
MAIMAI_REQUESTS_PER_SECOND=25
MAIMAI_PROGRESS_EDITS_PER_SECOND=8
MAIMAI_ANALYSIS_CACHE_MAX=500
# a stored read is reused while a quick check of maimai DX NET says nothing changed; after this many hours it is read in full anyway
MAIMAI_SNAPSHOT_MAX_AGE_HOURS=168
# an analysis already in memory is checked against maimai DX NET again when a command arrives this many minutes after the last check
MAIMAI_RECHECK_MINUTES=3
# leave empty to let Discord choose the shard count
DISCORD_SHARD_COUNT=

# web dashboard sign-in. From the Discord developer portal, OAuth2 page: copy the client id and secret,
# and add <MAIMAI_PUBLIC_URL>/auth/callback as a redirect. The "identify" and "email" scopes are used.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# the same sign-in with Google. From Google Cloud console, APIs & Services, Credentials: create an OAuth client
# of type "Web application" and add <MAIMAI_PUBLIC_URL>/auth/google/callback/ as an authorised redirect URI
# (with the trailing slash). Only the openid, email and profile scopes are used. Empty: the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile widget keys: the connect page and the dashboard sign-in show the widget
# and the server checks the token before a login code or a Discord sign-in can proceed. Empty: off.
CF_KEY=
CF_SECRET=

# the bot's install link from the same portal; /invite in Discord and <MAIMAI_PUBLIC_URL>/invite hand it out
DISCORD_BOT_INVITE=

# the support server's invite; /support in Discord and <MAIMAI_PUBLIC_URL>/support hand it out. Defaults to the Rasmai server
DISCORD_SUPPORT_INVITE=

# bot presence follows maimai's maintenance schedule: online, idle before it starts, do-not-disturb during it
MAIMAI_PRESENCE=true
MAIMAI_PRESENCE_REGION=intl

# your server's id: slash commands appear there instantly instead of after Discord's global delay
MAIMAI_GUILD_ID=
MAIMAI_DB_REFRESH_DAYS=7

# the bot uploads brand/emoji/png as its own application emoji on startup and uses them in replies
MAIMAI_EMOJI=true

# /chart and /song link each chart's video from SilentBlue RemyWiki (one page fetch per song, cached a month)
MAIMAI_WIKI_VIDEOS=true

# /news translates Japanese posts with a model running in Ollama on your own machine; Google Translate is the fallback and the default when this is empty.
# With the bot in Docker on a Mac, Ollama runs on the Mac itself (it uses the GPU there, a container cannot) and the bot reaches it at host.docker.internal.
# Run natively, use http://localhost:11434. See "Translating Japanese posts" in the README.
MAIMAI_TRANSLATE_URL=
# translategemma:12b is the accurate one, about 8 GB; translategemma:4b is 3.3 GB and noticeably less accurate
MAIMAI_TRANSLATE_MODEL=translategemma:12b
# how long Ollama keeps the model loaded after the last post; short, so the memory comes back
MAIMAI_TRANSLATE_KEEP_ALIVE=2m

# how the bot names itself when it reads the wikis and chart databases. Empty is
# rasmai/1.0 (+MAIMAI_PUBLIC_URL), so your copy asks under your own address. Adding a contact
# address is the polite thing: rasmai/1.0 (+https://your.site; contact you@example.com)
USER_AGENT=

MAIMAI_DEBUG=false
MAIMAI_DEBUG_EXPORT_JSON=false
