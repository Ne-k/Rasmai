# Settings for the beta bot, docker-compose.beta.yml. Copy to .env.beta, which is not committed.
# Everything not listed here keeps its default; the full list of settings is in .env.example.

# a second application's token from the Discord developer portal, never production's: the two bots would fight over one login
DISCORD_TOKEN=

# your test server's id, so the slash commands appear there at once. Without it they are registered for every server the bot is in.
MAIMAI_GUILD_ID=

# verbose logs, and a JSON dump of each analysis under beta/debug
MAIMAI_DEBUG=false

# translate /news posts with a model on this machine, as in .env.example; empty uses Google Translate
MAIMAI_TRANSLATE_URL=
MAIMAI_TRANSLATE_MODEL=translategemma:12b
