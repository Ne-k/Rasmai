DISCORD_TOKEN=
RASMAI_INTERNAL_SECRET=
RASMAI_SESSION_SECRET=

# where the beta is opened. Must be what you type in the browser, and is what the sign-in redirects come back to.
# Google and Discord both need <this>/auth/google/callback/ and <this>/auth/callback added as redirects.
MAIMAI_PUBLIC_URL=http://localhost:8766
BETA_PORT=8766

# the sign-in applications may be the live ones: only the redirect addresses above have to be added to them
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# left empty on purpose: the Turnstile keys are tied to the live domain and would block the widget here,
# the tunnel belongs to the live bot, and nobody should be admin of a trial
CF_KEY=
CF_SECRET=
MAIMAI_TUNNEL=
MAIMAI_BEHIND_CLOUDFLARE=false
MAIMAI_ADMIN_ID=
MAIMAI_CONTROL_GUILD_ID=
STATUSPAGE_TOKEN=
