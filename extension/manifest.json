{
  "manifest_version": 3,
  "name": "Aime sign-in helper",
  "version": "1.0.1",
  "description": "Link your maimai account to bots like Rasmai. Sends your sign-in to the bot page or link you choose, or copies it for you.",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://lng-tgk-aime-gw.am-all.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aime sign-in helper",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aime-signin-helper@rasmai.lol",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
